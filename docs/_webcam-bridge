#compdef webcam-bridge

_webcam-bridge() {
  local -a commands options exclusive_cmds

  commands=(
    'start:Start bridge'
    'stop:Stop bridge'
    'restart:Restart bridge'
    'status:Show bridge status'
    'exclusive:Manage exclusive mode (for Firefox)'
  )

  options=(
    '--bright[Preset for bright rooms (gain=2.0)]'
    '--normal[Preset for normal lighting (gain=4.0)]'
    '--dark[Preset for dim rooms (gain=8.0)]'
    '--night[Preset for very dark (gain=12.0)]'
    '--auto[Use auto-exposure]'
    '--gain[Set manual gain (1.0-16.0)]:gain:(1.0 2.0 4.0 6.0 8.0 12.0 16.0)'
    '--exposure[Set exposure time in microseconds]:exposure:(5000 8000 10000 15000 20000 25000 33000)'
  )

  exclusive_cmds=(
    'on:Enable exclusive mode'
    'off:Disable exclusive mode'
  )

  # Handle exclusive subcommand
  if [[ "$words[2]" == "exclusive" ]] || [[ "$words[3]" == "exclusive" ]]; then
    if [[ $CURRENT -eq 3 ]] || [[ $CURRENT -eq 4 && "$words[2]" == --* ]]; then
      _describe -t exclusive 'exclusive mode' exclusive_cmds
      return
    fi
  fi

  # Offer options and commands
  _arguments -s \
    $options \
    '1:command:->cmds'

  case "$state" in
    cmds)
      _describe -t commands 'webcam-bridge commands' commands
      ;;
  esac
}

_webcam-bridge "$@"
